# Copy to terraform.tfvars and edit. Real tfvars files are gitignored.

aws_region  = "us-east-1"
name_prefix = "synth"
environment = "dev"

# Recommended. With this set, an apply pointed at the wrong account fails
# immediately instead of creating resources you then have to find and remove.
allowed_account_ids = ["123456789012"]

tags = {
  Owner      = "<your-team>"
  CostCenter = "<your-cost-center>"
}

# Storage lever. Screenshots and HAR files dominate artifact cost, so shorten
# this before reaching for anything else.
artifact_retention_in_days = 30

# Encryption. Either let this stack own a key, or point it at one you already
# have and set create_kms_key = false.
create_kms_key = true
# kms_key_arn  = "arn:aws:kms:us-east-1:123456789012:key/<your-key-id>"

# --- Canaries ---------------------------------------------------------------
# Supplying an endpoint is what creates a canary. With both left unset, a plan
# produces only the artifacts bucket, its key, and the execution role.

api_endpoint        = "https://api.example.com/v1/health"
api_expected_status = 200
heartbeat_endpoint  = "https://www.example.com/"

# Cadence. One minute is the floor the service accepts.
api_canary_schedule_expression       = "rate(5 minutes)"
heartbeat_canary_schedule_expression = "rate(1 minute)"

# Runtime versions are region-scoped and are retired on a published schedule.
# Confirm the value is currently offered in your region before pinning it.
canary_runtime_version = "syn-nodejs-puppeteer-9.1"

# Where the packaged bundle comes from. Set exactly one source.
canary_code = {
  zip_path = "dist/canaries.zip"
}
# canary_code = {
#   s3_bucket = "<your-bucket-name>"
#   s3_key    = "canaries/canaries.zip"
# }

# Only needed when the plan-time budget guard refuses a canary name: canary
# names are capped at 21 characters, and the default prefix carries both
# name_prefix and environment.
# canary_name_prefix = "obs-stg"

# Extra canaries beyond the two built-in ones. A key of "api" or "heartbeat"
# replaces the built-in of that name outright.
# canaries = {
#   checkout = {
#     handler               = "checkout-canary.handler"
#     schedule_expression   = "rate(15 minutes)"
#     timeout_in_seconds    = 120
#     environment_variables = { TARGET_URL = "https://www.example.com/checkout" }
#   }
# }

# Only for endpoints that are not reachable from the internet. A canary inside
# your VPC stops proving anything about the path a real client takes.
# canary_vpc_config = {
#   subnet_ids         = ["<your-subnet-id>"]
#   security_group_ids = ["<your-security-group-id>"]
# }

# --- Real user monitoring ---------------------------------------------------
# Supplying a domain is what creates the app monitor, its Cognito identity pool
# and the guest role the browser snippet assumes. Leave it unset and none of
# the settings below are read.

rum_domain = "www.example.com"

# Cost lever. Every ingested event is billed, so raise this only as far as the
# question being asked actually requires.
rum_session_sample_rate = 0.1

rum_telemetries   = ["errors", "performance", "http"]
rum_allow_cookies = true
rum_enable_xray   = true

# Mirrors every event into CloudWatch Logs, which is the only way to query a
# single session — and the most expensive setting here. The plan-time guard
# refuses to combine it with a sample rate above 0.25.
rum_cw_log_enabled = false

# Off unless the page actually calls recordEvent.
rum_custom_events_enabled = false

# Use one list or the other, never both: an include list already excludes every
# page it does not name.
# rum_included_pages = ["https://www.example.com/checkout"]
# rum_excluded_pages = ["https://www.example.com/account"]
# rum_favorite_pages = ["https://www.example.com/"]

# Reuse an identity pool and guest role that already exist, instead of letting
# this configuration create them. Both are required together.
# rum_create_identity_pool = false
# rum_identity_pool_id     = "us-east-1:00000000-0000-0000-0000-000000000000"
# rum_guest_role_arn       = "arn:aws:iam::123456789012:role/<your-rum-guest-role>"
